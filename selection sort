class Solution {
public:
    vector<int> selectionSort(vector<int>& nums) {
     int n =nums.size();
     for(int i=0;i<n-1;i++){
        int small=i;
        for(int j=i+1;j<n;j++){
            if(nums[j]<nums[small])
            small=j;
        }
        swap(nums[i],nums[small]);
     }
     return nums;
    }
};
