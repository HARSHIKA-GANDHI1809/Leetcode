class Solution {
public:
    vector<int> insertionSort(vector<int>& nums) {
     int n =nums.size();
     for(int i=1;i<n;i++){
        int curr=nums[i];
        int prvs=i-1;
        while(prvs>=0&&nums[prvs]>curr){
            nums[prvs+1]=nums[prvs];
            prvs--;
        }
        nums[prvs+1]=curr;
     }
     return nums;
    }
};
